<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleIdentifier</key>
  <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
  <key>CFBundleExecutable</key>
  <string>$(EXECUTABLE_NAME)</string>
  <key>CFBundleName</key>
  <string>$(PRODUCT_NAME)</string>
  <key>CFBundleDisplayName</key>
  <string>IronLog</string>
  <key>CFBundlePackageType</key>
  <string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
  <key>CFBundleShortVersionString</key>
  <string>$(MARKETING_VERSION)</string>
  <key>CFBundleVersion</key>
  <string>$(CURRENT_PROJECT_VERSION)</string>
  <key>ITSAppUsesNonExemptEncryption</key>
  <false/>
  <key>UIUserInterfaceStyle</key>
  <string>Dark</string>
  <key>NSSupportsLiveActivities</key>
  <true/>
  <key>NSLocationWhenInUseUsageDescription</key>
  <string>IronLog uses your location while a run or walk is in progress to measure distance, pace and your route. Nothing is tracked when you are not recording.</string>
  <!-- Required for the run to keep measuring with the screen locked. Setting
       CLLocationManager.allowsBackgroundLocationUpdates without this throws. -->
  <key>UIBackgroundModes</key>
  <array>
    <string>location</string>
  </array>
  <key>UILaunchScreen</key>
  <dict>
    <key>UIColorName</key>
    <string>LaunchBackground</string>
  </dict>
  <key>UIApplicationSceneManifest</key>
  <dict>
    <key>UIApplicationSupportsMultipleScenes</key>
    <false/>
  </dict>
</dict>
</plist>
