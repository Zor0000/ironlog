<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>method</key>
  <string>app-store-connect</string>
  <key>destination</key>
  <string>export</string>
  <!-- Manual, and named down to the profile, so the export cannot fall back on
       asking Apple for a fresh signing certificate. Left automatic, it minted
       one per build until the account hit its limit and CI stopped working.
       These names match the Xcode project's Release configuration and
       scripts/install_provisioning_profiles.sh; change one, change all three. -->
  <key>signingStyle</key>
  <string>manual</string>
  <key>signingCertificate</key>
  <string>Apple Distribution</string>
  <key>provisioningProfiles</key>
  <dict>
    <key>com.parthjadhav.ironlog</key>
    <string>IronLog App Store</string>
    <key>com.parthjadhav.ironlog.IronLogWidget</key>
    <string>IronLog Widget App Store</string>
  </dict>
  <key>stripSwiftSymbols</key>
  <true/>
  <key>uploadSymbols</key>
  <true/>
  <key>teamID</key>
  <string>75LRT8TRQY</string>
</dict>
</plist>
