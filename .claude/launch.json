{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "ironlog-web",
      "runtimeExecutable": "python3",
      "runtimeArgs": ["-m", "http.server", "8765"],
      "port": 8765
    },
    {
      "name": "screenshot-studio",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "screenshot-studio", "run", "dev", "--", "-p", "3000"],
      "port": 3000
    },
    {
      "name": "website",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "website", "run", "dev", "--", "-p", "3001"],
      "port": 3001
    }
  ]
}
